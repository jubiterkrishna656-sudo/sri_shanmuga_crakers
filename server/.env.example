# Copy this file to server/.env and replace the values with real ones.
# Never commit the real server/.env file.

# Port the Express server listens on (client dev server proxies to this).
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/shanmuga-crackers

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# Credentials for the admin user created by `npm run seed`.
ADMIN_EMAIL=admin@shanmuga.com
ADMIN_PASSWORD=change-this-admin-password

# Minimum order total in INR. Keep in sync with client/src/utils/constants.js.
# Defaults to 2500 when unset.
# MIN_ORDER_AMOUNT=2500

# Extra origins allowed by the CSP connect-src directive (comma separated).
# Keep the localhost dev origins; replace with your domain(s) in production.
# Defaults to: http://localhost:3000,http://localhost:5000,ws://localhost:*
# CSP_CONNECT_SOURCES=https://shop.example.com

# Customer order tracking uses WhatsApp wa.me links (no API needed).
# The admin WhatsApp number (with country code) is hardcoded in server/utils/whatsapp.js.
